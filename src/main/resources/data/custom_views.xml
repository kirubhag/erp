        <viewName>All Students</viewName>
        <description>All students in the system</description>
        <entityType>STUDENT</entityType>
        <isDefault>true</isDefault>
        <isPublic>true</isPublic>
        <selectedFields>
            <field>studentId</field>
            <field>firstName</field>
            <field>lastName</field>
            <field>gradeLevel</field>
            <field>section</field>
            <field>isActive</field>
        </selectedFields>
