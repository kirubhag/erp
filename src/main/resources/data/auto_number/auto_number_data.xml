<!--
    Auto Number Configuration Data
    
    This file contains the initial configuration for auto-number fields across all entities.
    Each auto_number entry defines:
    - entity_type: The entity this auto-number belongs to (matches EntityType enum)
    - field_name: The field that will receive the auto-generated number
    - prefix: Text prepended to the number (e.g., "STU-" produces "STU-0001")
    - suffix: Text appended to the number (optional)
    - next_number: The next number to be generated (starts at 1)
    - padding_length: Number of digits to pad with zeros (default 4)
    - description: Human-readable description of this auto-number sequence
    
    Format examples:
    - prefix="STU-", padding=4, number=1 → "STU-0001"
    - prefix="INV-2024-", suffix="-Q1", padding=5 → "INV-2024-00001-Q1"
    - prefix="", padding=6, number=1 → "000001"
-->
