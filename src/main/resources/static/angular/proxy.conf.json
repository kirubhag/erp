{
  "/api": {
    "target": "http://localhost:8081",
    "secure": false,
    "logLevel": "debug",
    "changeOrigin": true,
    "cookieDomainRewrite": "localhost",
    "cookiePathRewrite": "/",
    "bypass": function(req, res, proxyOptions) {
      if (req.headers['cookie']) {
        return null;
      }
    }
  },
  "/settings": {
    "target": "http://localhost:8081",
    "secure": false,
    "logLevel": "debug",
    "changeOrigin": true,
    "cookieDomainRewrite": "localhost",
    "cookiePathRewrite": "/",
    "bypass": function(req, res, proxyOptions) {
      // Bypass proxy for Angular routes
      if (req.url.startsWith('/settings/auth/')) {
        return '/index.html';
      }
      if (req.headers['cookie']) {
        return null;
      }
    }
  }
}
