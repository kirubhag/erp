<!-- Student Detail Page -->
<div class="student-detail-container">
    <!-- Header with Navigation -->
    <div class="detail-header">
        <div class="header-navigation">
            <button class="btn btn-outline-secondary" ng-click="goBack()">
                <i class="fas fa-arrow-left me-2"></i>Back to Students
            </button>
            <div class="header-actions">
                <button class="btn btn-primary" ng-click="editItem()">
                    <i class="fas fa-edit me-2"></i>Edit
                </button>
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="actionsDropdown" 
                            data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-ellipsis-v"></i>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="actionsDropdown">
                        <li><a class="dropdown-item" href="#" ng-click="duplicateItem()">
                            <i class="fas fa-copy me-2"></i>Duplicate
                        </a></li>
                        <li><a class="dropdown-item" href="#" ng-click="exportStudent()">
                            <i class="fas fa-download me-2"></i>Export
                        </a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="#" ng-click="deleteItem()">
                            <i class="fas fa-trash me-2"></i>Delete
                        </a></li>
                    </ul>
                </div>
            </div>
        </div>
        
        <!-- Student Header Info -->
        <div class="student-header-info">
            <div class="student-avatar-large">
                <div class="avatar-circle-large" ng-style="getAvatarStyle(student)">
                    {{getAvatarInitials(student)}}
                </div>
            </div>
            <div class="student-basic-info">
                <h1 class="student-name">{{student.firstName}} {{student.lastName}}</h1>
                <div class="student-meta">
                    <span class="student-id-badge">ID: {{student.studentId}}</span>
                    <span class="student-grade">{{formatGradeName(student.gradeLevel)}}</span>
                    <span class="student-status" ng-class="'status-' + (student.enrollmentStatus || 'enrolled').toLowerCase()">
                        {{student.enrollmentStatus || 'Enrolled'}}
                    </span>
                </div>
                <div class="last-update">
                    Last Update: {{student.modifiedTime | date:'MMM dd, yyyy'}} ago
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="detail-content">
        <div class="row">
            <!-- Left Column - Main Details -->
            <div class="col-lg-8">
                <!-- Tab Navigation -->
                <ul class="nav nav-tabs detail-tabs" id="studentTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="overview-tab" data-bs-toggle="tab" 
                                data-bs-target="#overview" type="button" role="tab">Overview</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="timeline-tab" data-bs-toggle="tab" 
                                data-bs-target="#timeline" type="button" role="tab">Timeline</button>
                    </li>
                </ul>

                <!-- Tab Content -->
                <div class="tab-content detail-tab-content" id="studentTabsContent">
                    <!-- Overview Tab -->
                    <div class="tab-pane fade show active" id="overview" role="tabpanel">
                        <!-- Basic Information Section -->
                        <div class="detail-section">
                            <h3 class="section-title">Basic Information</h3>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="detail-field">
                                        <label class="field-label">Email</label>
                                        <div class="field-value">
                                            <a href="mailto:{{student.email}}" ng-if="student.email">{{student.email}}</a>
                                            <span class="text-muted" ng-if="!student.email">-</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="detail-field">
                                        <label class="field-label">Student ID</label>
                                        <div class="field-value">{{student.studentId}}</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="detail-field">
                                        <label class="field-label">Phone</label>
                                        <div class="field-value">
                                            <a href="tel:{{student.phoneNumber}}" ng-if="student.phoneNumber">{{student.phoneNumber}}</a>
                                            <span class="text-muted" ng-if="!student.phoneNumber">-</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="detail-field">
                                        <label class="field-label">Date of Birth</label>
                                        <div class="field-value">{{student.dateOfBirth | date:'MMM dd, yyyy'}}</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="detail-field">
                                        <label class="field-label">Gender</label>
                                        <div class="field-value">{{student.gender | capitalize}}</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="detail-field">
                                        <label class="field-label">Enrollment Date</label>
                                        <div class="field-value">{{student.enrollmentDate | date:'MMM dd, yyyy'}}</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Address Information Section -->
                        <div class="detail-section" ng-if="student.address">
                            <h3 class="section-title">Address Information</h3>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="detail-field">
                                        <label class="field-label">Street</label>
                                        <div class="field-value">{{student.address.street || '-'}}</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="detail-field">
                                        <label class="field-label">City</label>
                                        <div class="field-value">{{student.address.city || '-'}}</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="detail-field">
                                        <label class="field-label">State</label>
                                        <div class="field-value">{{student.address.state || '-'}}</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="detail-field">
                                        <label class="field-label">Zip Code</label>
                                        <div class="field-value">{{student.address.zipCode || '-'}}</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Emergency Contact Section -->
                        <div class="detail-section" ng-if="student.emergencyContact">
                            <h3 class="section-title">Emergency Contact</h3>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="detail-field">
                                        <label class="field-label">Name</label>
                                        <div class="field-value">{{student.emergencyContact.name || '-'}}</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="detail-field">
                                        <label class="field-label">Phone</label>
                                        <div class="field-value">
                                            <a href="tel:{{student.emergencyContact.phoneNumber}}" ng-if="student.emergencyContact.phoneNumber">
                                                {{student.emergencyContact.phoneNumber}}
                                            </a>
                                            <span class="text-muted" ng-if="!student.emergencyContact.phoneNumber">-</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="detail-field">
                                        <label class="field-label">Relationship</label>
                                        <div class="field-value">{{student.emergencyContact.relationship || '-'}}</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Additional Information -->
                        <div class="detail-section" ng-if="student.notes">
                            <h3 class="section-title">Additional Information</h3>
                            <div class="detail-field">
                                <label class="field-label">Notes</label>
                                <div class="field-value">{{student.notes}}</div>
                            </div>
                        </div>
                    </div>

                    <!-- Timeline Tab -->
                    <div class="tab-pane fade" id="timeline" role="tabpanel">
                        <div class="timeline-section">
                            <h3 class="section-title">Recent Activity</h3>
                            <div class="timeline-item" ng-repeat="activity in studentActivities">
                                <div class="timeline-marker">
                                    <i class="fas fa-{{activity.icon}}"></i>
                                </div>
                                <div class="timeline-content">
                                    <div class="timeline-header">
                                        <strong>{{activity.title}}</strong>
                                        <span class="timeline-date">{{activity.date | date:'MMM dd, yyyy HH:mm'}}</span>
                                    </div>
                                    <p class="timeline-description">{{activity.description}}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column - Related Lists -->
            <div class="col-lg-4">
                <div class="related-section">
                    <h3 class="related-title">Related List</h3>
                    
                    <!-- Notes Section -->
                    <div class="related-item">
                        <div class="related-header">
                            <span class="related-name">Notes</span>
                            <span class="related-count">{{studentNotes.length}}</span>
                        </div>
                    </div>
                    
                    <!-- Attachments Section -->
                    <div class="related-item">
                        <div class="related-header">
                            <span class="related-name">Attachments</span>
                            <span class="related-count">{{studentAttachments.length}}</span>
                        </div>
                    </div>
                    
                    <!-- Courses Section -->
                    <div class="related-item">
                        <div class="related-header">
                            <span class="related-name">My Courses</span>
                            <span class="related-count">{{studentCourses.length}}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading State -->
    <div class="loading-overlay" ng-show="loading">
        <div class="loading-content">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="loading-text">Loading student details...</p>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" ng-class="{'show d-block': showDeleteModal}" tabindex="-1" ng-show="showDeleteModal">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title">
                        <i class="fas fa-exclamation-triangle text-danger me-2"></i>
                        Confirm Delete
                    </h5>
                    <button type="button" class="btn-close" ng-click="cancelDelete()"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        Are you sure you want to delete 
                        <strong>{{studentToDelete.firstName}} {{studentToDelete.lastName}}</strong>?
                    </p>
                    <p class="text-muted small mb-0 mt-2">
                        <i class="fas fa-info-circle me-1"></i>
                        This action cannot be undone.
                    </p>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" ng-click="cancelDelete()">
                        <i class="fas fa-times me-1"></i>Cancel
                    </button>
                    <button type="button" class="btn btn-danger" ng-click="confirmDelete()">
                        <i class="fas fa-trash me-1"></i>Delete Student
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" ng-class="{'show': showDeleteModal}" ng-show="showDeleteModal"></div>
</div>

<!-- Styles -->
<style>
.student-detail-container {
    min-height: 100vh;
    background-color: #f8f9fa;
}

.detail-header {
    background: white;
    border-bottom: 1px solid #e1e5e9;
    padding: 24px;
}

.header-navigation {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
}

.header-actions {
    display: flex;
    gap: 12px;
    align-items: center;
}

.student-header-info {
    display: flex;
    align-items: center;
    gap: 24px;
}

.avatar-circle-large {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 32px;
    font-weight: 600;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.student-name {
    font-size: 28px;
    font-weight: 600;
    color: #1a202c;
    margin: 0 0 8px 0;
}

.student-meta {
    display: flex;
    gap: 12px;
    margin-bottom: 8px;
}

.student-id-badge {
    background: #e0e7ff;
    color: #3730a3;
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 500;
}

.student-grade {
    background: #dbeafe;
    color: #1e40af;
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 500;
}

.student-status {
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 500;
}

.status-enrolled {
    background: #d1fae5;
    color: #065f46;
}

.status-pending {
    background: #fef3c7;
    color: #92400e;
}

.status-withdrawn {
    background: #fee2e2;
    color: #991b1b;
}

.last-update {
    color: #6b7280;
    font-size: 14px;
}

.detail-content {
    padding: 24px;
}

.detail-tabs {
    border-bottom: 2px solid #e5e7eb;
    margin-bottom: 24px;
}

.detail-tabs .nav-link {
    border: none;
    border-bottom: 2px solid transparent;
    color: #6b7280;
    font-weight: 500;
    padding: 12px 24px;
}

.detail-tabs .nav-link.active {
    background: none;
    border-bottom: 2px solid #3b82f6;
    color: #3b82f6;
}

.detail-section {
    background: white;
    border-radius: 8px;
    padding: 24px;
    margin-bottom: 24px;
    border: 1px solid #e5e7eb;
}

.section-title {
    font-size: 18px;
    font-weight: 600;
    color: #374151;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid #e5e7eb;
}

.detail-field {
    margin-bottom: 16px;
}

.field-label {
    display: block;
    font-size: 12px;
    font-weight: 500;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
}

.field-value {
    font-size: 14px;
    color: #374151;
    font-weight: 500;
}

.field-value a {
    color: #3b82f6;
    text-decoration: none;
}

.field-value a:hover {
    text-decoration: underline;
}

.related-section {
    background: white;
    border-radius: 8px;
    border: 1px solid #e5e7eb;
    overflow: hidden;
}

.related-title {
    font-size: 16px;
    font-weight: 600;
    color: #374151;
    padding: 20px 20px 16px 20px;
    margin: 0;
    border-bottom: 1px solid #e5e7eb;
}

.related-item {
    padding: 16px 20px;
    border-bottom: 1px solid #f3f4f6;
}

.related-item:last-child {
    border-bottom: none;
}

.related-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.related-name {
    font-size: 14px;
    font-weight: 500;
    color: #374151;
}

.related-count {
    background: #f3f4f6;
    color: #6b7280;
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 12px;
    font-weight: 500;
}

.timeline-item {
    display: flex;
    gap: 16px;
    margin-bottom: 24px;
}

.timeline-marker {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #3b82f6;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.timeline-content {
    flex: 1;
}

.timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.timeline-date {
    font-size: 12px;
    color: #6b7280;
}

.timeline-description {
    font-size: 14px;
    color: #6b7280;
    margin: 0;
}

.loading-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(255, 255, 255, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
}

.loading-content {
    text-align: center;
}

.loading-text {
    margin-top: 16px;
    color: #6b7280;
    font-size: 14px;
}
</style>