<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %c{1} - %msg%n"/>
        </Console>
        <!-- Prefer system property, then env var, then default -->
    <RollingFile name="RollingFile" fileName="${sys:APP_LOG_PATH:-${env:APP_LOG_PATH:-${sys:java.io.tmpdir}/erp}}/erp-dev.log" filePattern="${sys:APP_LOG_PATH:-${env:APP_LOG_PATH:-${sys:java.io.tmpdir}/erp}}/erp-dev-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %c{1} - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="20MB"/>
            </Policies>
            <DefaultRolloverStrategy max="14"/>
        </RollingFile>
        <RollingFile name="AccessRollingFile" fileName="${sys:APP_LOG_PATH:-${env:APP_LOG_PATH:-${sys:java.io.tmpdir}/erp}}/access-log.log" filePattern="${sys:APP_LOG_PATH:-${env:APP_LOG_PATH:-${sys:java.io.tmpdir}/erp}}/access-log-%d{dd-MM-yyyy}.log.gz">
            <PatternLayout pattern="%m%n" />
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true" />
            </Policies>
            <DefaultRolloverStrategy max="90"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- Verbose development logging -->
        <Logger name="krs.erp" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>

        <Logger name="org.springframework" level="info"/>

        <Root level="debug">
            <AppenderRef ref="Console"/>
        </Root>

        <Logger name="ACCESS" level="info" additivity="false">
            <AppenderRef ref="AccessRollingFile"/>
            <!-- Also echo access logs to console in dev for quick validation -->
            <AppenderRef ref="Console"/>
        </Logger>
    </Loggers>
</Configuration>
