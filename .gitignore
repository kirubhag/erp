# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Maven
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Gradle
.gradle
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# IDE
.idea/
*.iml
*.ipr
*.iws
# VS Code - ignore most but allow configuration files
.vscode/*
!.vscode/settings.json
!.vscode/org.eclipse.jdt.core.prefs
*.swp
*.swo

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Application specific
application-local.properties
/logs/
/uploads/
/data/

# Angular build outputs - keep only production builds in static
node_modules/
**/angular/.angular/
**/angular/dist/
**/angular/node_modules/

# Old chunk naming pattern (replaced by erp-app-* naming)
**/static/chunk-*.js
**/static/chunk-*.js.map

# Angular build artifacts (generated files, should not be in git)
**/static/erp-app-*.js
**/static/erp-app-*.js.map
**/static/build-manifest.json

# Duplicate Angular build outputs (keep only in angular/dist/)
**/static/main-*.js
**/static/polyfills-*.js
**/static/styles-*.css
**/static/index.html
**/static/favicon.ico
**/static/assets/
**/static/media/
**/static/vendor/

# Database migration backup/disabled files
**/*.sql.disabled
**/*.sql.bak

# IDE and temp files
**/.DS_Store
**/*.swp
**/*.swo